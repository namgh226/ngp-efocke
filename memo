    if(snap.val()) MY_PIN = snap.val();
  });
  if(sessionStorage.getItem('myScheduleLoggedIn')==='1'){
    document.getElementById('pinOverlay').classList.add('hidden');
    initFirebase();
  }
})();
</script>
