function saveDay(){
  if(currentDayType==='off'){
    const dt = getDefaultDayType(new Date(modalKey.replace(/-/g,'/')));
    if(dt==='off'){ delete overrides[modalKey]; }
    else overrides[modalKey] = {dayType:'off', shift:null, event:null, memo:''};
  } else {
    const data = collectModalData();
    const hasData = !!data.shift || !!data.event || data.memo;
    const dt = getDefaultDayType(new Date(modalKey.replace(/-/g,'/')));
    if(!hasData && currentDayType===dt){ delete overrides[modalKey]; }
    else overrides[modalKey] = data;
  }
  closeModal(); saveToFirebase();
}
