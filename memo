/* ===== 주차 복사 (평일만, 토/일/공휴일 제외) ===== */
async function applyWeekCopy(){
  if(!modalKey || !modalDate) return;
  const srcData = collectModalData();
  const dow = modalDate.getDay();
  const monday = new Date(modalDate);
  monday.setDate(modalDate.getDate() + (dow===0 ? -6 : 1-dow));

  const targets = [];
  for(let i=0;i<5;i++){
    const d = new Date(monday); d.setDate(monday.getDate()+i);
    const key = toKey(d);
    if(key===modalKey) continue;
    if(isHolidayDate(d)) continue;
    targets.push({date:d, key});
  }
  if(targets.length===0){ alert('적용할 수 있는 평일이 없습니다!'); return; }

  const hasData = targets.filter(t=>overrides[t.key]);
  const noData = targets.filter(t=>!overrides[t.key]);

  const applyOne = (t)=>{
    overrides[t.key] = JSON.parse(JSON.stringify(srcData));
  };

  if(hasData.length>0){
    const dateList = hasData.map(t=>`${t.date.getMonth()+1}월 ${t.date.getDate()}일`).join(', ');
    const msg = `이미 데이터가 있는 날짜:\n${dateList}\n\n덮어쓰시겠습니까?\n\n[확인] 모두 덮어쓰기\n[취소] 건너뛰기`;
    const overwrite = confirm(msg);
    if(overwrite){
      targets.forEach(applyOne);
    } else {
      noData.forEach(applyOne);
      if(noData.length===0){ alert('건너뛸 날짜만 있어서 적용된 날짜가 없습니다.'); return; }
    }
  } else {
    targets.forEach(applyOne);
  }

  closeModal(); saveToFirebase();
  alert('✅ 주차 근무가 적용되었습니다!');
}

