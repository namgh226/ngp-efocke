function renderStats(){
  const year = parseInt(document.getElementById('statsYearSel').value);
  const annualStats = {annualH:0, familyCnt:0, fitnessCnt:0, maternityCnt:0};
  const monthlyStats = {};
  for(let m=1;m<=12;m++) monthlyStats[m] = {weekdayExtH:0, weekdayNightH:0, holidayH:0, holidayNightH:0};

  Object.entries(overrides).forEach(([key,ov])=>{
    if(!key.startsWith(year+'-')) return;
    const date = new Date(key.replace(/-/g,'/'));
    const month = date.getMonth()+1;
    const isHoliday = isHolidayDate(date);

    if(ov.shift && ov.shift.type && ov.shift.type!=='none'){
      const sH = parseFloat(ov.shift.startH), eH = parseFloat(ov.shift.endH);
      if(!isNaN(sH) && !isNaN(eH)){
        if(isHoliday){
          const {holidayH,holidayNightH} = calcHolidayPay(sH,eH);
          monthlyStats[month].holidayH += holidayH;
          monthlyStats[month].holidayNightH += holidayNightH;
        } else {
          const {extH,nightH} = calcWeekdayPay(sH,eH);
          monthlyStats[month].weekdayExtH += extH;
          monthlyStats[month].weekdayNightH += nightH;
        }
      }
    }
    if(ov.event && ov.event.type && ov.event.type!=='none'){
      switch(ov.event.type){
        case 'off':       annualStats.annualH += 8; break;
        case 'groupoff':  annualStats.annualH += 8; break;
        case 'timeleave': annualStats.annualH += parseFloat(ov.event.hours||4); break;
        case 'family':    annualStats.familyCnt++; break;
        case 'fitness':   annualStats.fitnessCnt++; break;
        case 'maternity': annualStats.maternityCnt++; break;
      }
    }
  });

  let html = `<div class="stats-section-title">📅 연간 통계 (${year}년)</div>`;
  const annualDay = annualStats.annualH>0 ? (annualStats.annualH/8).toFixed(2).replace(/\.?0+$/,'')+'일' : '-';
  html += `<table class="stats-table"><thead><tr>
    <th>연차<br><small>(일)</small></th>
    <th>가족사랑<br><small>(횟수)</small></th>
    <th>체력단련<br><small>(횟수)</small></th>
    <th>출산휴가<br><small>(일)</small></th>
  </tr></thead><tbody>
    <tr>
      <td>${annualDay}</td>
      <td>${annualStats.familyCnt>0?annualStats.familyCnt+'회':'-'}</td>
      <td>${annualStats.fitnessCnt>0?annualStats.fitnessCnt+'회':'-'}</td>
      <td>${annualStats.maternityCnt>0?annualStats.maternityCnt+'일':'-'}</td>
    </tr>
  </tbody></table>`;

  html += `<div class="stats-section-title" style="margin-top:20px;">📆 월별 시간외 근무 현황
    <select class="stats-month-sel" id="statsMonthSel" onchange="renderMonthlyTable()">`;
  for(let m=1;m<=12;m++){
    html += `<option value="${m}" ${m===currentMonth+1?'selected':''}>${m}월</option>`;
  }
  html += `</select></div><div id="monthlyTableWrap"></div>`;

  document.getElementById('statsContent').innerHTML = html;
  window._monthlyStats = monthlyStats;
  renderMonthlyTable();
}

