const API_KEY = '823de722f0ec21001a1155607329fb20c3f7f883afc5e51e5f21db8fe7587e55';

async function fetchHolidays(year){
  if(holidayCache[year]) return holidayCache[year];
  const statusEl = document.getElementById('holidayStatus');
  try{
    statusEl.textContent = `🔄 ${year}년 공휴일 불러오는 중...`;
    const holidays={}, promises=[];
    for(let m=1;m<=12;m++){
      const url = `https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService/getRestDeInfo?solYear=${year}&solMonth=${String(m).padStart(2,'0')}&ServiceKey=${API_KEY}&_type=json&numOfRows=20`;
      promises.push(fetch(url).then(r=>r.json()).then(data=>{
        const items = data?.response?.body?.items?.item; if(!items) return;
        (Array.isArray(items)?items:[items]).forEach(item=>{
          const d = String(item.locdate);
          holidays[`${d.slice(0,4)}-${d.slice(4,6)}-${d.slice(6,8)}`] = item.dateName;
        });
      }).catch(()=>{}));
    }
    await Promise.all(promises);
    if(!Object.keys(holidays).length) throw new Error();
    holidayCache[year] = holidays;
    statusEl.textContent = `✅ ${year}년 공휴일 업데이트 완료!`;
    statusEl.className = 'holiday-status success';
    setTimeout(()=>{ statusEl.style.display='none'; },3000);
    return holidayCache[year];
  } catch {
    holidayCache[year] = HOLIDAY_FALLBACK[year] || {};
    statusEl.textContent = `⚠️ 기본 공휴일 데이터 사용`;
    statusEl.className = 'holiday-status error';
    return holidayCache[year];
  }
}
function getHoliday(key){
  const year = parseInt(key.substring(0,4));
  return (holidayCache[year]||HOLIDAY_FALLBACK[year]||{})[key];
}

