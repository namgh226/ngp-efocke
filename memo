/* ===== 시간 계산 (0.5시간 단위) ===== */
function calcHours(startH, endH){
  const s = Math.round(startH*2);
  const e = Math.round(endH*2);
  const eAdj = e<=s ? e+48 : e;
  let nightUnits=0, dayUnits=0;
  for(let u=s;u<eAdj;u++){
    const hourOfDay = (((u%48)+48)%48)/2;
    if(hourOfDay>=22||hourOfDay<6) nightUnits++;
    else dayUnits++;
  }
  return { dayH:dayUnits/2, nightH:nightUnits/2, totalH:(eAdj-s)/2 };
}
function calcWeekdayPay(startH,endH){
  const{nightH,totalH} = calcHours(startH,endH);
  const extH = Math.max(0,totalH-8);
  return {extH,nightH};
}
function calcHolidayPay(startH,endH){
  const{nightH,totalH} = calcHours(startH,endH);
  return {holidayH:totalH, holidayNightH:nightH};
}
function getExtHours(startH,endH,dayType){
  const{totalH} = calcHours(startH,endH);
  return dayType==='normal' ? Math.max(0,totalH-8) : totalH;
}
function fmtH(h){ if(!h||h===0) return '-'; return (Math.round(h*10)/10)+'h'; }
function fmtTime(h){
  if(h==null||isNaN(h)) return '-';
  const isNext = h>=24;
  let hh = Math.floor(h)%24;
  let mm = Math.round((h-Math.floor(h))*60);
  if(mm===60){ mm=0; hh=(hh+1)%24; }
  let str = mm===0 ? `${hh}시` : `${hh}시${mm}분`;
  if(isNext) str += '(익일)';
  return str;
}

