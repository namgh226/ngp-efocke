function renderCalendar(){
  const tbody = document.getElementById('calBody'); tbody.innerHTML='';
  const firstDay = new Date(currentYear,currentMonth,1).getDay();
  const lastDate = new Date(currentYear,currentMonth+1,0).getDate();
  const prevLast = new Date(currentYear,currentMonth,0).getDate();
  const today = new Date();
  let date=1, nextDate=1;
  for(let row=0;row<6;row++){
    const tr = document.createElement('tr'); let rhc=false;
    for(let col=0;col<7;col++){
      const td = document.createElement('td');
      let cellDate, isCurrent=true; const cn = row*7+col;
      if(cn<firstDay){
        cellDate = new Date(currentYear,currentMonth-1,prevLast-firstDay+cn+1);
        isCurrent=false; td.classList.add('other-month');
      } else if(date>lastDate){
        cellDate = new Date(currentYear,currentMonth+1,nextDate++);
        isCurrent=false; td.classList.add('other-month');
      } else {
        cellDate = new Date(currentYear,currentMonth,date++); rhc=true;
      }
      if(col===0) td.classList.add('sunday');
      if(col===6) td.classList.add('saturday');
      if(cellDate.toDateString()===today.toDateString()) td.classList.add('today');
      const key = toKey(cellDate);
      const ov = overrides[key];
      const dayType = ov ? ov.dayType : getDefaultDayType(cellDate);
      if(!td.classList.contains('other-month')){
        td.classList.add(dayType==='off'?'day-off':dayType==='special'?'day-special':'day-normal');
      }
      const numDiv = document.createElement('div'); numDiv.className='date-num';
      numDiv.textContent = cellDate.getDate();
      if(ov && ov.memo){
        const icon=document.createElement('span'); icon.className='memo-icon'; icon.textContent='📌';
        icon.addEventListener('click', e=>{
          e.stopPropagation();
          const dateLabel = `${cellDate.getFullYear()}년 ${cellDate.getMonth()+1}월 ${cellDate.getDate()}일`;
